# Copy this file to .env and fill in your keys.
# .env is loaded by docker-compose and the pipeline at runtime.
# Never commit .env to version control.
GENIUS_API_TOKEN=your-genius-api-token-here

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Langfuse observability (get keys from langfuse.com → Project Settings)
# If omitted, the pipeline runs normally with no tracing.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=ypur-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"